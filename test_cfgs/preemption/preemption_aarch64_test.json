{
    "is_unittest": false,
    "test_name": "preemption",
    "n_runs": 4,
    "timeout_ms": 60000,
    "expected_output_path": "test_cfgs/preemption/out.txt",
    "target": "aarch64",
    "qemu_args": [
        "-machine",
        "virt,acpi=off",
        "-cpu",
        "cortex-a72",
        "-bios",
        "{PATH_TO_EFI}",
        "-drive",
        "file={PATH_TO_IMG},format=raw",
        "-drive",
        "if=none,file={PATH_TO_DISK},format=raw,id=disk0",
        "-device",
        "virtio-blk-device,drive=disk0",
        "-no-reboot",
        "-D",
        "qemu.log",
        "-m",
        "4G",
        "-smp",
        "4",
        "-display",
        "none"
    ]
}
