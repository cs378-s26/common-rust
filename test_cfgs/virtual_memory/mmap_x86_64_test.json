{
    "is_unittest": false,
    "test_name": "virtual_memory",
    "n_runs": 1,
    "timeout_ms": 60000,
    "expected_output_path": "test_cfgs/virtual_memory/out.txt",
    "target": "x86_64",
    "qemu_args": [
        "-machine",
        "q35,smm=off",
        "-bios",
        "{PATH_TO_EFI}",
        "-drive",
        "file={PATH_TO_IMG},format=raw",
        "-no-reboot",
        "-D",
        "qemu.log",
        "-m",
        "4G",
        "-smp",
        "4",
        "-device",
        "isa-debug-exit,iobase=0xf4,iosize=0x04",
        "-display",
        "none"
    ]
}
