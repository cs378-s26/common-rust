{
    "is_unittest": false,
    "test_name": "example_integration",
    "n_runs": 1,
    "expected_output_path": "test_cfgs/example_integration/out.txt",
    "target": "x86_64",
    "qemu_args": [
        "-bios",
        "{PATH_TO_EFI}",
        "-drive",
        "file={PATH_TO_IMG},format=raw",
        "-no-reboot",
        "-D",
        "qemu.log",
        "-M",
        "smm=off",
        "-m",
        "4G",
        "-smp",
        "4",
        "-device",
        "isa-debug-exit,iobase=0xf4,iosize=0x04",
        "-display",
        "none"
    ]
}
